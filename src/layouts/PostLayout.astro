---
import Layout from "./Layout.astro";
import "katex/dist/katex.min.css";
import { categories } from "../data/categories";


interface Props {
    title: string;
    description: string;
    date: Date;
    category: string;
    lang: string;
    tags: string[];
}

const {
    title,
    description,
    date,
    category,
    lang,
    tags,
} = Astro.props;

const categoryInfo = categories[category as keyof typeof categories];

---

<Layout
    title={`${title} · Starrylume`}
    description={description}
    lang={lang}
    type="article"
>
    <main>
        <article>
            <header class="post-header">
                <h1>{title}</h1>

                <div class="post-meta">
                    <time class="post-date" datetime={date.toISOString()}>
                        {date.toLocaleDateString("en-US", {
                            year: "numeric",
                            month: "long",
                            day: "numeric",
                        })}
                    </time>

                    <span aria-hidden="true">·</span>

                    {
                        categoryInfo ? (
                            <a
                                class="post-category"
                                href={`/categories/${category}/`}
                            >
                                {categoryInfo.name}
                            </a>
                        ) : (
                            <span>{category}</span>
                        )
                    }
                </div>

                <div class="post-tags">
                    {
                        tags.map((tag) => (
                            <a class="post-tag" href={`/tags/${tag}/`}>
                                {tag}
                            </a>
                        ))
                    }
                </div>
            </header>

            <slot />
        </article>
    </main>
</Layout>

<style>
    main {
        position: relative;
        z-index: 1;

        max-width: 760px;
        margin: 0 auto;
        padding: var(--space-3xl) var(--space-xl);
        box-sizing: border-box;
    }

    article {
        width: 100%;
    }

    .post-header {
        margin-bottom: var(--space-2xl);
    }

    .post-header h1 {
        margin: 0 0 var(--space-md);

        font-size: 2.5rem;
        font-weight: 500;
        line-height: 1.15;
    }

    .post-header time {
        color: var(--text-faint);
        font-size: var(--text-sm);
    }

    article {
        line-height: 1.75;
    }

    article :global(p) {
        margin: 1.25rem 0;
    }

    article :global(h2) {
        margin: 2.75rem 0 1rem;
        font-size: 1.65rem;
        font-weight: 500;
        line-height: 1.3;
    }

    article :global(h3) {
        margin: 2rem 0 0.75rem;
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.4;
    }

    article :global(a) {
        color: var(--text);
        text-decoration-color: var(--text-faint);
        text-underline-offset: 0.25rem;
    }

    article :global(a:hover) {
        text-decoration-color: var(--text);
    }

    article :global(ul),
    article :global(ol) {
        margin: 1.25rem 0;
        padding-left: 1.5rem;
    }

    article :global(li) {
        margin: 0.4rem 0;
    }

    article :global(blockquote) {
        margin: 1.75rem 0;
        padding-left: 1.25rem;
        color: var(--text-muted);
        border-left: 2px solid var(--line);
    }

    article :global(code) {
        padding: 0.15em 0.35em;
        font-family: var(--font-mono);        
        font-size: 0.9em;
        background: rgba(255, 255, 255, 0.05);
        border-radius: 0.25rem;
    }

        article :global(pre) {
        margin: 1.75rem 0;
        padding: 1.25rem 1.5rem;
        overflow-x: auto;
        line-height: 1.6;
        background: rgba(255, 255, 255, 0.035);
        border: 1px solid var(--line);
        border-radius: 0.4rem;
    }

    article :global(pre code) {
        padding: 0;
        font-size: 0.9rem;
        background: none;
        border-radius: 0;
    }

    article :global(img) {
        display: block;
        max-width: 100%;
        height: auto;
        margin: 2rem auto;
        border-radius: 0.4rem;
    }

    .post-meta {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        color: var(--text-faint);
        font-size: var(--text-sm);
    }

    .post-category {
        color: var(--text-faint);
        text-decoration: none;
        transition: color 0.25s;
    }

    .post-category:hover {
        color: var(--text);
    }

    .post-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        margin-top: var(--space-md);
    }

    .post-tag {
        padding: 0.25rem 0.6rem;
        color: var(--firefly);
        font-size: 0.8rem;
        line-height: 1.4;
        text-decoration: none;
        background: rgba(143, 216, 200, 0.06);
        border: 1px solid rgba(143, 216, 200, 0.16);
        border-radius: 999px;
    }

    .post-tag:hover {
        border-color: var(--firefly);
    }
</style>
